# Copy this file to .env and fill in your values
# NEVER commit the real .env to GitHub

# ── Server ───────────────────────────────
PORT=5000
NODE_ENV=production

# ── MongoDB Atlas ─────────────────────────
# Get from: https://cloud.mongodb.com
# Format: mongodb+srv://username:password@cluster.xxxxx.mongodb.net/mywebsite
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mywebsite?retryWrites=true&w=majority

# ── JWT ──────────────────────────────────
# Any long random string — keep it secret!
JWT_SECRET=replace_with_long_random_secret_here
JWT_EXPIRE=7d

# ── CORS ─────────────────────────────────
# Set to your Render URL after first deploy
CLIENT_URL=https://your-app-name.onrender.com
